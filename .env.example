ENVIRONMENT=development
# Hosted Postgres (e.g. Neon): paste the unpooled connection string as-is; postgresql://, sslmode and
# channel_binding are converted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://anymob:anymob@localhost:5432/anymob
REDIS_URL=redis://localhost:6379/0
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
# Cloudflare R2: both endpoints https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto, and a bucket CORS
# rule allowing PUT/GET with the Content-Type header from the frontend origins.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=anymob
S3_SECRET_KEY=anymob-local-storage
S3_BUCKET=anymob
S3_REGION=us-east-1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@anymob.local
SMS_PROVIDER=disabled
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=

# Serverless hosts (Vercel): client IP header set by the platform, bearer secret for scheduled jobs, and
# delivering outbox events (email, media) within the request instead of a Celery worker.
TRUSTED_IP_HEADER=
CRON_SECRET=
OUTBOX_INLINE=false

# Reset endpoint additionally requires a development database ending in _demo.
DEMO_RESET_ENABLED=false
